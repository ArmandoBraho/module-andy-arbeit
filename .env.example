# Google Maps (Servicegebiet polygon + markers)
# Create a key in Google Cloud Console and enable "Maps JavaScript API".
VITE_GOOGLE_MAPS_API_KEY=

# Web3Forms (Terminanfrage → E-Mail)
# Create a free access key at https://web3forms.com using kontakt@andyarbeit.info
# The access key is public-safe (it only aliases the destination inbox).
# Optional: Web3Forms Pro enables .ics calendar attachments (best for Outlook).
VITE_WEB3FORMS_ACCESS_KEY=

# Optional: receive completed session events (JSON POST / sendBeacon).
# Only used after Statistik cookie consent. Example payload:
# { "type":"session_end", "id":"...", "startedAt":"...", "endedAt":"...", "durationMs":12345, "path":"/" }
VITE_ANALYTICS_ENDPOINT=
